# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JEV_REMOTE_TOKEN=

# Jev begins each new browser task here. Google is a safe first test; replace it
# with your preferred streaming service after the browser-harness demo works.
JEV_START_URL=https://www.google.com/
JEV_REMOTE_HOST=0.0.0.0
JEV_REMOTE_PORT=8787

# Required API configuration. These values stay on the PC and never go to the phone.
TYPESAFE_API_KEY=
OPENAI_API_KEY=
TEXT_MODEL=gpt-5-nano

# Chrome remote-debugging endpoint of the dedicated Jev profile (see README)
BU_CDP_URL=http://127.0.0.1:9222

# Optional: USD per 1M tokens, used to print a cost estimate per command
JEV_PRICE_INPUT_PER_1M=
JEV_PRICE_OUTPUT_PER_1M=

# Chrome auto-launch on start (1 = on). Profile defaults to ../work/jev-chrome-profile
JEV_AUTO_LAUNCH_CHROME=1
JEV_CHROME_PROFILE=

# Safety caps on paid API calls (0 disables a cap)
JEV_MAX_STEPS_PER_COMMAND=25
JEV_MAX_JEV_CALLS_PER_HOUR=200
JEV_MAX_OPENAI_CALLS_PER_HOUR=50
